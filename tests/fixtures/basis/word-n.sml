fun show w = print (Word32.toString w ^ "\n")
val _ = print (Int.toString (Word.toInt 0w2000000000) ^ "\n")
val _ = show (Word32.notb 0w0)
val _ = show (Word32.+ (0wxFFFFFFFF, 0w2))
val _ = show (Word32.- (0w0, 0w1))
val _ = show (Word32.<< (0wxFF, 0w28))
val _ = show (Word32.>> (0wx80000000, 0w31))
val _ = show (Word32.~>> (0wx80000000, 0w4))
val _ = print (Int.toString (Word32.toIntX 0wxFFFFFFFF) ^ "\n")
val _ = print (Int.toString (Word32.toInt 0wxFFFFFFFF) ^ "\n")
val _ = print (Int.toString Word32.wordSize ^ " " ^ Int.toString Word16.wordSize ^ "\n")
val _ = print (Word16.toString (Word16.* (0wx100, 0wx100)) ^ "\n")
