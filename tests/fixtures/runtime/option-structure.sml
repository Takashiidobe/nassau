fun pi n = print (Int.toString n ^ "\n")
fun opt NONE = "none" | opt (SOME n) = Int.toString n
fun line s = print (s ^ "\n")
val () = line (opt (SOME 1) ^ " " ^ opt NONE)
val () = pi (Option.valOf (SOME 4) + valOf (SOME 5))
val () = pi (Option.getOpt (NONE, 7) + getOpt (SOME 1, 7))
val () = line ((if Option.isSome (SOME 1) then "some" else "none") ^ (if isSome NONE then "some" else "none"))
val () = line (opt (Option.map (fn n => n * 2) (SOME 4)) ^ " " ^ opt (Option.map (fn n => n * 2) NONE))
val () = line (opt (Option.join (SOME (SOME 3))) ^ " " ^ opt (Option.join (SOME NONE)) ^ " " ^ opt (Option.join NONE))
val () = line (opt (Option.filter (fn n => n > 1) 2) ^ " " ^ opt (Option.filter (fn n => n > 1) 1))
fun halve n = if n mod 2 = 0 then SOME (n div 2) else NONE
val half = Option.mapPartial halve
val () = line (opt (half (SOME 8)) ^ " " ^ opt (half (SOME 7)) ^ " " ^ opt (half NONE))
val calls = ref 0
val () = Option.app (fn n => calls := !calls + n) (SOME 5)
val () = Option.app (fn n => calls := !calls + n) NONE
val () = pi (!calls)
val () = line (opt (Option.compose (fn n => n + 1, fn n => if n > 0 then SOME n else NONE) 3) ^ " " ^ opt (Option.compose (fn n => n + 1, fn n => if n > 0 then SOME n else NONE) 0))
val () = line (opt (Option.composePartial (halve, fn n => SOME (n * 2)) 3) ^ " " ^ opt (Option.composePartial (halve, fn n => if n > 0 then SOME n else NONE) 0))
val () = pi (valOf NONE handle Option => ~1)
val () = pi (Option.valOf NONE handle Option.Option => ~2)
val () = pi (case Option.map (fn n => n + 1) (SOME 1) of SOME n => n | NONE => 0)
