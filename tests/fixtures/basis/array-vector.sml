fun ints l = String.concatWith "," (map Int.toString l) ^ "\n"
fun vl v = Vector.foldr (op ::) [] v
fun al a = Array.foldr (op ::) [] a
val v = Vector.fromList [1, 2, 3, 4, 5]
val _ = print (ints (vl v))
val _ = print (Int.toString (Vector.length v) ^ " " ^ Int.toString (Vector.sub (v, 2)) ^ "\n")
val _ = print (ints (vl (Vector.tabulate (4, fn i => i * i))))
val _ = print (ints (vl (Vector.map (fn x => x + 1) v)))
val _ = print (ints (vl (Vector.update (v, 1, 20))))
val _ = print (ints (vl (Vector.concat [v, Vector.fromList [9]])))
val _ = print (ints (Vector.foldl (fn (x, a) => x :: a) [] v))
val _ = print (ints (vl (Vector.mapi (fn (i, x) => i * x) v)))
val _ = print (case Vector.find (fn x => x > 3) v of SOME x => Int.toString x ^ "\n" | NONE => "none\n")
val _ = print (Bool.toString (Vector.exists (fn x => x = 3) v) ^ Bool.toString (Vector.all (fn x => x > 1) v) ^ "\n")
val _ = print ((Vector.sub (v, 5); "no\n") handle Subscript => "subscript\n")
val _ = print ((Vector.tabulate (~1, fn i => i); "no\n") handle Size => "size\n")
val _ = print (Bool.toString (Vector.fromList [1, 2] = Vector.fromList [1, 2]) ^ "\n")
val a = Array.fromList [5, 6, 7]
val _ = Array.update (a, 1, 60)
val _ = print (ints (al a))
val b = Array.array (3, 0)
val _ = print (Bool.toString (a = a) ^ Bool.toString (a = Array.fromList [5, 60, 7]) ^ "\n")
val _ = Array.copy {src = a, dst = b, di = 0}
val _ = print (ints (al b))
val _ = Array.modify (fn x => x + 1) b
val _ = print (ints (al b))
val _ = print (ints (vl (Array.vector b)))
val _ = Array.appi (fn (i, x) => print (Int.toString i ^ ":" ^ Int.toString x ^ " ")) b
val _ = print "\n"
val _ = print (Int.toString (Array.foldl (op +) 0 b) ^ " " ^ Int.toString (Array.length b) ^ "\n")
val _ = print ((Array.sub (b, ~1); "no\n") handle Subscript => "subscript\n")
val _ = print ((Array.array (~1, 0); "no\n") handle Size => "size\n")
val _ = print (Int.toString (Array.length (Array.tabulate (4, fn i => i))) ^ "\n")
val _ = print (Int.toString (Array.length (Array.fromList [])) ^ "\n")
val s = Array.array (2, "x")
val _ = Array.update (s, 0, "yy")
val _ = print (String.concat (al s) ^ "\n")
val r = Array.array (2, 0.5)
val _ = Array.update (r, 1, 1.5)
val _ = print (Int.toString (Real.floor (Array.sub (r, 0) + Array.sub (r, 1))) ^ "\n")
