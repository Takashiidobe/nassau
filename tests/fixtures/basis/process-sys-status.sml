fun show label value = print (label ^ ": " ^ value ^ "\n")
fun ok cmd = if OS.Process.isSuccess (OS.Process.system cmd) then "success" else "failure"
val _ = show "true" (ok "true")
val _ = show "false" (ok "false")
val _ = show "missing" (ok "nassau-no-such-command-xyz 2>/dev/null")
val _ = show "env passthrough" (ok "test -n \"$PATH\"")
val _ = OS.Process.atExit (fn () => print "bye\n")
val _ = show "path set" (case OS.Process.getEnv "PATH" of SOME p => if size p > 0 then "yes" else "empty" | NONE => "no")
val _ = show "unset var" (case OS.Process.getEnv "NASSAU_SURELY_UNSET_VAR" of SOME _ => "set" | NONE => "none")
(* CHECK-EXIT: 0 *)
(* CHECK-STDOUT: true: success *)
(* CHECK-STDOUT-NEXT: false: failure *)
(* CHECK-STDOUT-NEXT: missing: failure *)
(* CHECK-STDOUT-NEXT: env passthrough: success *)
(* CHECK-STDOUT-NEXT: path set: yes *)
(* CHECK-STDOUT-NEXT: unset var: none *)
(* CHECK-STDOUT-NEXT: bye *)
(* WASM-SKIP: OS.Process.system raises SysErr in the browser *)
