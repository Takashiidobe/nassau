(* = on an enumeration or a reference compares words; on anything else, and
   on an equality type variable, it calls the runtime. *)
datatype color = Red | Green
fun same (a : color, b) = a = b
fun alias (r : int ref, s) = r = s
fun lists (a : int list, b) = a = b
fun poly (a, b) = a = b
(* CHECK-STDOUT: global g0 same *)
(* CHECK-STDOUT-NEXT: global g1 alias *)
(* CHECK-STDOUT-NEXT: global g2 lists *)
(* CHECK-STDOUT-NEXT: global g3 poly *)
(* CHECK-STDOUT-NEXT: fn f1 same(v0:env, v1) { *)
(* CHECK-STDOUT-NEXT:   b0(): *)
(* CHECK-STDOUT-NEXT:     v4 = v1.0 *)
(* CHECK-STDOUT-NEXT:     v5 = v1.1 *)
(* CHECK-STDOUT-NEXT:     jump b1(v4, v5) *)
(* CHECK-STDOUT-NEXT:   b1(v2:a, v3:b): *)
(* CHECK-STDOUT-NEXT:     v6 = word.eq(v2, v3) *)
(* CHECK-STDOUT-NEXT:     return v6 *)
(* CHECK-STDOUT-NEXT: } *)
(* CHECK-STDOUT-NEXT: fn f2 alias(v0:env, v1) { *)
(* CHECK-STDOUT-NEXT:   b0(): *)
(* CHECK-STDOUT-NEXT:     v4 = v1.0 *)
(* CHECK-STDOUT-NEXT:     v5 = v1.1 *)
(* CHECK-STDOUT-NEXT:     jump b1(v4, v5) *)
(* CHECK-STDOUT-NEXT:   b1(v2:r, v3:s): *)
(* CHECK-STDOUT-NEXT:     v6 = word.eq(v2, v3) *)
(* CHECK-STDOUT-NEXT:     return v6 *)
(* CHECK-STDOUT-NEXT: } *)
(* CHECK-STDOUT-NEXT: fn f3 lists(v0:env, v1) { *)
(* CHECK-STDOUT-NEXT:   b0(): *)
(* CHECK-STDOUT-NEXT:     v4 = v1.0 *)
(* CHECK-STDOUT-NEXT:     v5 = v1.1 *)
(* CHECK-STDOUT-NEXT:     jump b1(v4, v5) *)
(* CHECK-STDOUT-NEXT:   b1(v2:a, v3:b): *)
(* CHECK-STDOUT-NEXT:     v6 = equal(v2, v3) *)
(* CHECK-STDOUT-NEXT:     return v6 *)
(* CHECK-STDOUT-NEXT: } *)
(* CHECK-STDOUT-NEXT: fn f4 poly(v0:env, v1) { *)
(* CHECK-STDOUT-NEXT:   b0(): *)
(* CHECK-STDOUT-NEXT:     v4 = v1.0 *)
(* CHECK-STDOUT-NEXT:     v5 = v1.1 *)
(* CHECK-STDOUT-NEXT:     jump b1(v4, v5) *)
(* CHECK-STDOUT-NEXT:   b1(v2:a, v3:b): *)
