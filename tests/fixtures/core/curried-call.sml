(* A saturated curried call goes straight to the worker without allocating;
   a partial application allocates a closure per argument. *)
fun add x y = x + y
val five = add 2 3
val increment = add 1
(* CHECK-STDOUT: global g0 add *)
(* CHECK-STDOUT-NEXT: global g1 five *)
(* CHECK-STDOUT-NEXT: global g2 increment *)
(* CHECK-STDOUT-NEXT: fn f1 add(v0:env, v1:x, v2:y) { *)
(* CHECK-STDOUT-NEXT:   b0(): *)
(* CHECK-STDOUT-NEXT:     v3 = int.add(v1, v2) *)
(* CHECK-STDOUT-NEXT:     return v3 *)
(* CHECK-STDOUT-NEXT:   b1(): *)
(* CHECK-STDOUT-NEXT:     fail Match at curried-call.sml:3.20 *)
(* CHECK-STDOUT-NEXT: } *)
(* CHECK-STDOUT-NEXT: fn f2 add(v0:env, v1) { *)
(* CHECK-STDOUT-NEXT:   b0(): *)
(* CHECK-STDOUT-NEXT:     v2 = closure f3(v0, v1) *)
(* CHECK-STDOUT-NEXT:     return v2 *)
(* CHECK-STDOUT-NEXT: } *)
(* CHECK-STDOUT-NEXT: fn f3 add(v0:env, v1) { *)
(* CHECK-STDOUT-NEXT:   b0(): *)
(* CHECK-STDOUT-NEXT:     v2 = v0.1 *)
(* CHECK-STDOUT-NEXT:     v3 = v0.2 *)
(* CHECK-STDOUT-NEXT:     v4 = call f1[v2](v3, v1) *)
(* CHECK-STDOUT-NEXT:     return v4 *)
(* CHECK-STDOUT-NEXT: } *)
(* CHECK-STDOUT-NEXT: fn f0 main() { *)
(* CHECK-STDOUT-NEXT:   b0(): *)
(* CHECK-STDOUT-NEXT:     v0:add = closure f2() *)
(* CHECK-STDOUT-NEXT:     g0 := v0 *)
(* CHECK-STDOUT-NEXT:     v1:add = g0 *)
(* CHECK-STDOUT-NEXT:     v2 = call f1[v1](#2, #3) *)
(* CHECK-STDOUT-NEXT:     g1 := v2 *)
(* CHECK-STDOUT-NEXT:     v3:add = g0 *)
(* CHECK-STDOUT-NEXT:     v4 = call v3(#1) *)
(* CHECK-STDOUT-NEXT:     g2 := v4 *)
(* CHECK-STDOUT-NEXT:     return #0 *)
(* CHECK-STDOUT-NEXT: } *)
