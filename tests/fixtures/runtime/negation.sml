fun pi n = print (Int.toString n ^ "\n")
fun pb b = print (if b then "true\n" else "false\n")
val () = pi (~ 3)
val () = pb (~ 2.5 < 0.0 andalso ~ 2.5 > ~ 2.6)
val () = pi (foldl (fn (x, a) => x + a) 0 (map ~ [1, 2]))
val () = pi ((op ~) 4)
val () = pi (~ (~ 1))
fun neg x = ~ x
val () = pi (neg 5)
fun negr (x : real) = ~ x
val () = pb (negr 1.5 < 0.0)
val () = pb (hd (map ~ [1.5]) < 0.0)
val () = pi (~ 3 + 1)
val () = pi (((op ~ o op ~) 5) + ~ (~ 2))
