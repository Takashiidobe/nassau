fun show label value = print (label ^ ": " ^ value ^ "\n")
fun bool true = "true" | bool false = "false"
fun bytes s = Word8VectorSlice.full (Byte.stringToBytes s)

val (left, right) = UnixSock.Strm.socketPair ()
val l = Socket.ioDesc left
val r = Socket.ioDesc right
val _ = show "kind socket" (bool (OS.IO.kind l = OS.IO.Kind.socket))
val _ = show "kind differs" (bool (OS.IO.kind l <> OS.IO.Kind.pipe))
val _ = show "same desc" (bool (OS.IO.compare (l, l) = EQUAL))
val _ = show "different desc" (bool (OS.IO.compare (l, r) <> EQUAL))
val _ = show "hash stable" (bool (OS.IO.hash l = OS.IO.hash l))
val pl = valOf (OS.IO.pollDesc l)
val pr = valOf (OS.IO.pollDesc r)
val _ = show "round trip" (bool (OS.IO.compare (OS.IO.pollToIODesc pl, l) = EQUAL))
val none = SOME Time.zeroTime
val _ = show "idle in" (Int.toString (length (OS.IO.poll ([OS.IO.pollIn pr], none))))
val ready = OS.IO.poll ([OS.IO.pollOut pl], none)
val _ = show "writable" (bool (length ready = 1 andalso OS.IO.isOut (hd ready)))
val _ = show "writable not in" (bool (not (OS.IO.isIn (hd ready))))
val _ = Socket.sendVec (left, bytes "x")
val got = OS.IO.poll ([OS.IO.pollIn pr, OS.IO.pollIn pl], SOME (Time.fromMilliseconds 1000))
val _ = show "readable count" (Int.toString (length got))
val _ = show "readable in" (bool (OS.IO.isIn (hd got)))
val _ = show "info desc" (bool (OS.IO.compare (OS.IO.pollToIODesc (OS.IO.infoToPollDesc (hd got)), r) = EQUAL))
val _ = show "empty poll" (Int.toString (length (OS.IO.poll ([], none))))

val _ = show "errorName" (OS.errorName (valOf (OS.syserror "EACCES")))
val _ = show "syserror" (case OS.syserror "ENOENT" of SOME n => OS.errorName n | NONE => "none")
val _ = show "syserror bad" (case OS.syserror "NOTANERRNO" of SOME _ => "some" | NONE => "none")
val a = OS.FileSys.fileId "."
val b = OS.FileSys.fileId "/"
val _ = show "hash equal" (bool (OS.FileSys.hash a = OS.FileSys.hash (OS.FileSys.fileId ".")))
val _ = show "hash differs" (bool (OS.FileSys.hash a <> OS.FileSys.hash b))
