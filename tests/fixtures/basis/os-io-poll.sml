(* CHECK-STDOUT-NEXT: different desc: true *)
(* CHECK-STDOUT-NEXT: hash stable: true *)
(* CHECK-STDOUT-NEXT: round trip: true *)
(* CHECK-STDOUT-NEXT: idle in: 0 *)
(* CHECK-STDOUT-NEXT: writable: true *)
(* CHECK-STDOUT-NEXT: writable not in: true *)
(* CHECK-STDOUT-NEXT: readable count: 1 *)
(* CHECK-STDOUT-NEXT: readable in: true *)
(* CHECK-STDOUT-NEXT: info desc: true *)
(* CHECK-STDOUT-NEXT: empty poll: 0 *)
(* CHECK-STDOUT-NEXT: errorName: EACCES *)
(* CHECK-STDOUT-NEXT: syserror: ENOENT *)
(* CHECK-STDOUT-NEXT: syserror bad: none *)
