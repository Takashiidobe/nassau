structure E = Posix.ProcEnv
fun show label value = print (label ^ ": " ^ value ^ "\n")
fun bool true = "true" | bool false = "false"
val self = E.getpid ()
val _ = show "pid positive" (bool (Posix.Process.pidToWord self > 0w0))
val _ = show "ppid positive" (bool (Posix.Process.pidToWord (E.getppid ()) > 0w0))
val _ = show "pgrp positive" (bool (Posix.Process.pidToWord (E.getpgrp ()) > 0w0))
val _ = show "uid = euid" (bool (E.getuid () = E.geteuid ()))
val _ = show "gid = egid" (bool (E.getgid () = E.getegid ()))
val _ = show "uid words" (bool (E.wordToUid (E.uidToWord (E.getuid ())) = E.getuid ()))
val _ = show "gid words" (bool (E.wordToGid (E.gidToWord (E.getgid ())) = E.getgid ()))
val _ = show "groups" (bool (length (E.getgroups ()) >= 0))
val _ = show "uname keys" (String.concatWith "," (List.filter (fn k => List.exists (fn (j, _) => j = k) (E.uname ())) ["machine","nodename","release","sysname","version"]))
val _ = show "uname values" (bool (List.all (fn (_, v) => size v > 0) (E.uname ())))
val _ = show "time sane" (bool (Time.toSeconds (E.time ()) > 1000000000))
val t = E.times ()
val _ = show "times sane" (bool (Time.>= (#utime t, Time.zeroTime) andalso Time.>= (#elapsed t, Time.zeroTime)))
val _ = show "getenv PATH" (bool (E.getenv "PATH" <> NONE))
val _ = show "getenv unset" (bool (E.getenv "NASSAU_SURELY_UNSET_VAR" = NONE))
val _ = show "environ has PATH" (bool (List.exists (fn e => String.isPrefix "PATH=" e) (E.environ ())))
val _ = show "ctermid" (E.ctermid ())
val _ = show "isatty bad fd" (bool (E.isatty (Posix.FileSys.wordToFD 0w999)))
val _ = show "sysconf OPEN_MAX" (bool (E.sysconf "OPEN_MAX" > 0w0))
val _ = show "sysconf CLK_TCK" (bool (E.sysconf "CLK_TCK" > 0w0))
val _ = show "sysconf bogus" ((E.sysconf "BOGUS"; "ok") handle OS.SysErr _ => "SysErr")
(* CHECK-EXIT: 0 *)
(* CHECK-STDOUT: pid positive: true *)
(* CHECK-STDOUT-NEXT: ppid positive: true *)
(* CHECK-STDOUT-NEXT: pgrp positive: true *)
(* CHECK-STDOUT-NEXT: uid = euid: true *)
(* CHECK-STDOUT-NEXT: gid = egid: true *)
(* CHECK-STDOUT-NEXT: uid words: true *)
(* CHECK-STDOUT-NEXT: gid words: true *)
(* CHECK-STDOUT-NEXT: groups: true *)
(* CHECK-STDOUT-NEXT: uname keys: machine,nodename,release,sysname,version *)
(* CHECK-STDOUT-NEXT: uname values: true *)
(* CHECK-STDOUT-NEXT: time sane: true *)
(* CHECK-STDOUT-NEXT: times sane: true *)
(* CHECK-STDOUT-NEXT: getenv PATH: true *)
(* CHECK-STDOUT-NEXT: getenv unset: true *)
(* CHECK-STDOUT-NEXT: environ has PATH: true *)
(* CHECK-STDOUT-NEXT: ctermid: /dev/tty *)
(* CHECK-STDOUT-NEXT: isatty bad fd: false *)
(* CHECK-STDOUT-NEXT: sysconf OPEN_MAX: true *)
(* CHECK-STDOUT-NEXT: sysconf CLK_TCK: true *)
(* CHECK-STDOUT-NEXT: sysconf bogus: SysErr *)
