fun say b = print ((if b then "yes" else "no") ^ "\n")
val () = print (Int.toString 0 ^ "," ^ Int.toString 10 ^ "," ^ Int.toString ~10 ^ "\n")
val () = print (Int.toString ~1073741824 ^ "," ^ Int.toString 1073741823 ^ "\n")
val () = say (("" ^ "") = "" andalso ("" ^ "12345678") = "12345678")
val () = say (("12345678" ^ "") = "12345678" andalso ("1234" ^ "5678") = "12345678")
val () = say (("a\000" ^ "b") = "a\000b" andalso ("a\000" ^ "c") <> "a\000b")
val () = say (size ("12345678" ^ "abcdefgh") = 16)
fun build (0, xs) = xs | build (n, xs) = build (n - 1, n :: xs)
val () = say (build (100000, []) = build (100000, []))
val () = say ([(("a\000b", [1, 2]), SOME "tail")] = [(("a\000" ^ "b", [1, 2]), SOME "tail")])
val () = say (["same", "short"] <> ["same", "longer"])
val cell = ref 1
val () = say ([cell] = [cell] andalso [cell] <> [ref 1])
