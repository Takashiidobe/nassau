fun ints l = String.concatWith "," (map Int.toString l) ^ "\n"
val v = Vector.fromList [1, 2, 3, 4, 5, 6]
val vs = VectorSlice.slice (v, 1, SOME 3)
val _ = print (ints (VectorSlice.foldr (op ::) [] vs))
val _ = print (Int.toString (VectorSlice.length vs) ^ " " ^ Int.toString (VectorSlice.sub (vs, 0)) ^ "\n")
val vs2 = VectorSlice.subslice (vs, 1, NONE)
val _ = print (ints (VectorSlice.foldr (op ::) [] vs2))
val _ = print (ints (Vector.foldr (op ::) [] (VectorSlice.vector vs)))
val _ = print (ints (VectorSlice.foldr (op ::) [] (VectorSlice.full v)))
val _ = print (case VectorSlice.find (fn x => x > 2) vs of SOME x => Int.toString x ^ "\n" | NONE => "none\n")
val _ = print (Bool.toString (VectorSlice.isEmpty (VectorSlice.slice (v, 6, NONE))) ^ "\n")
val _ = print ((VectorSlice.slice (v, 4, SOME 5); "no\n") handle Subscript => "subscript\n")
val a = Array.fromList [1, 2, 3, 4, 5, 6]
val as_ = ArraySlice.slice (a, 2, SOME 3)
val _ = ArraySlice.update (as_, 0, 30)
val _ = print (ints (Array.foldr (op ::) [] a))
val _ = ArraySlice.modify (fn x => x * 2) as_
val _ = print (ints (Array.foldr (op ::) [] a))
val dst = Array.array (6, 0)
val _ = ArraySlice.copy {src = as_, dst = dst, di = 1}
val _ = print (ints (Array.foldr (op ::) [] dst))
val _ = print (ints (Vector.foldr (op ::) [] (ArraySlice.vector as_)))
val (base, start, len) = ArraySlice.base as_
val _ = print (Int.toString start ^ " " ^ Int.toString len ^ " " ^ Bool.toString (base = a) ^ "\n")
val g = Array2.array (2, 3, 0)
val _ = Array2.update (g, 1, 2, 7)
val _ = Array2.update (g, 0, 1, 4)
val _ = print (Int.toString (Array2.sub (g, 1, 2)) ^ " " ^ Int.toString (Array2.nRows g) ^ " " ^ Int.toString (Array2.nCols g) ^ "\n")
val _ = print (ints (Array2.fold Array2.RowMajor (op ::) [] g))
val _ = print (ints (Array2.fold Array2.ColMajor (op ::) [] g))
val t = Array2.tabulate Array2.RowMajor (2, 2, fn (r, c) => r * 10 + c)
val _ = print (ints (Array2.fold Array2.RowMajor (fn (x, a) => a @ [x]) [] t))
val _ = print (ints (Vector.foldr (op ::) [] (Array2.row (t, 1))))
val _ = print (ints (Vector.foldr (op ::) [] (Array2.column (t, 0))))
val _ = Array2.modify Array2.RowMajor (fn x => x + 1) t
val _ = print (ints (Array2.fold Array2.RowMajor (fn (x, a) => a @ [x]) [] t))
val _ = print ((Array2.sub (g, 2, 0); "no\n") handle Subscript => "subscript\n")
val f = Array2.fromList [[1, 2], [3, 4]]
val _ = print (ints (Array2.fold Array2.RowMajor (fn (x, a) => a @ [x]) [] f))
(* CHECK-STDOUT: 2,3,4 *)
