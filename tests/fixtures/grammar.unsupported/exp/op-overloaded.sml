(* SML'97 grammar, expression: op on overloaded operators (nassau-ugc.22). *)
fun pi n = print (Int.toString n ^ "\n")
val _ = pi (op + (1, 2))
val _ = pi (foldl op * 1 [2, 3, 4])
val _ = print (if op < (1, 2) then "lt\n" else "ge\n")
