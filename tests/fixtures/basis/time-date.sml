val t = Time.fromReal 1234.5678
val _ = print (Time.fmt 0 t ^ " " ^ Time.fmt 2 t ^ " " ^ Time.toString t ^ " " ^ Time.toString (Time.fromReal ~1.5) ^ " " ^ Time.fmt 5 (Time.fromReal 0.000005) ^ "\n")
val _ = print (Time.toString (valOf (Time.fromString " 12.25x")) ^ " " ^ Time.toString (valOf (Time.fromString "~3")) ^ "\n")
val _ = print (Bool.toString (Option.isSome (Time.fromString "abc")) ^ "\n")
val _ = print (Time.toString (Time.- (Time.fromReal 2.5, Time.fromReal 4.0)) ^ "\n")
val d = Date.fromTimeUniv (Time.fromSeconds 1000000000)
val _ = print (Date.toString d ^ "\n")
val _ = print (Date.fmt "%Y-%m-%d %H:%M:%S %a %A %b %B %j %y %p %I %%" d ^ "\n")
val _ = print (Int.toString (Date.year d) ^ " " ^ Int.toString (Date.yearDay d) ^ " " ^ Int.toString (Date.minute d) ^ " " ^ Bool.toString (Date.weekDay d = Date.Sun) ^ "\n")
val _ = print (LargeInt.toString (Time.toSeconds (Date.toTime d)) ^ "\n")
val old = Date.fromTimeUniv (Time.fromSeconds ~86400)
val _ = print (Date.toString old ^ "\n")
val made = Date.date {year = 2024, month = Date.Feb, day = 30, hour = 25, minute = 61, second = 61, offset = SOME Time.zeroTime}
val _ = print (Date.toString made ^ " " ^ Int.toString (Date.yearDay made) ^ "\n")
val _ = print (Date.toString (valOf (Date.fromString "Sun Sep 09 01:46:40 2001")) ^ "\n")
val local_ = Date.fromTimeLocal (Time.fromSeconds 1000000000)
val _ = print (Bool.toString (Time.toSeconds (Date.toTime local_) = 1000000000) ^ "\n")
val big = Date.fromTimeUniv (Time.fromReal 1700000000.0)
val _ = print (Date.toString big ^ " " ^ Int.toString (Date.yearDay big) ^ "\n")
val _ = print (Bool.toString (Real.== (Time.toReal (Date.toTime big), 1700000000.0)) ^ "\n")
val _ = print (Bool.toString (Real.== (Time.toReal (Date.toTime (Date.fromTimeLocal (Time.fromReal 1700000000.0))), 1700000000.0)) ^ "\n")
