fun show x = print (IntInf.toString x ^ "\n")
val big = IntInf.pow (IntInf.fromInt 2, 100)
val neg = IntInf.~ (IntInf.pow (IntInf.fromInt 3, 50))
val seven = IntInf.fromInt 7
val _ = show big
val _ = show neg
val _ = show (IntInf.+ (big, neg))
val _ = show (IntInf.* (big, neg))
val _ = show (IntInf.div (neg, seven))
val _ = show (IntInf.mod (neg, seven))
val _ = show (IntInf.quot (neg, seven))
val _ = show (IntInf.rem (neg, seven))
val (q, r) = IntInf.divMod (IntInf.~ seven, IntInf.fromInt 2)
val _ = show q
val _ = show r
val _ = show (IntInf.div (big, IntInf.pow (IntInf.fromInt 10, 20)))
val _ = show (IntInf.mod (big, IntInf.pow (IntInf.fromInt 10, 20)))
val _ = print (Int.toString (IntInf.log2 big) ^ " " ^ Int.toString (IntInf.log2 (IntInf.fromInt 1)) ^ "\n")
val _ = print (IntInf.fmt StringCvt.HEX big ^ " " ^ IntInf.fmt StringCvt.BIN (IntInf.fromInt 10) ^ "\n")
val _ = show (valOf (IntInf.fromString "-123456789012345678901234567890"))
val _ = show (IntInf.andb (IntInf.~ (IntInf.fromInt 12), IntInf.fromInt 10))
val _ = show (IntInf.orb (IntInf.~ (IntInf.fromInt 12), IntInf.fromInt 10))
val _ = show (IntInf.xorb (IntInf.~ (IntInf.fromInt 12), IntInf.~ (IntInf.fromInt 10)))
val _ = show (IntInf.andb (IntInf.~ big, IntInf.+ (big, IntInf.fromInt 5)))
val _ = show (IntInf.notb big)
val _ = show (IntInf.<< (IntInf.fromInt 3, 0w70))
val _ = show (IntInf.~>> (IntInf.~ big, 0w98))
val _ = show (IntInf.~>> (IntInf.~ (IntInf.fromInt 5), 0w1))
val _ = print (Int.toString (IntInf.toInt (IntInf.fromInt ~1073741824)) ^ "\n")
val _ = print ((IntInf.toInt big; "no overflow\n") handle Overflow => "overflow\n")
val _ = print ((IntInf.toInt (IntInf.fromInt 1073741823) ; "ok\n") handle Overflow => "overflow\n")
val _ = print ((IntInf.div (big, IntInf.fromInt 0); "no\n") handle Div => "div\n")
val _ = print (Bool.toString (IntInf.< (neg, big)) ^ " " ^ Bool.toString (IntInf.compare (big, big) = EQUAL) ^ " " ^ Int.toString (IntInf.sign neg) ^ "\n")
val _ = show (IntInf.abs neg)
val _ = show (IntInf.max (neg, big))
