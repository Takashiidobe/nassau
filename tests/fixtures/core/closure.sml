(* A fn captures n into its closure; calling an unknown function goes through the closure. *)
fun adder n = fn x => x + n
val addTwo = adder 2
val three = addTwo 1
(* CHECK-STDOUT: global g0 adder *)
(* CHECK-STDOUT-NEXT: global g1 addTwo *)
(* CHECK-STDOUT-NEXT: global g2 three *)
(* CHECK-STDOUT-NEXT: fn f2 fn(v0:env, v1:x) { *)
(* CHECK-STDOUT-NEXT:   b0(): *)
(* CHECK-STDOUT-NEXT:     v2:n = v0.1 *)
(* CHECK-STDOUT-NEXT:     v3 = int.add(v1, v2) *)
(* CHECK-STDOUT-NEXT:     return v3 *)
(* CHECK-STDOUT-NEXT:   b1(): *)
(* CHECK-STDOUT-NEXT:     fail Match at closure.sml:2.28 *)
(* CHECK-STDOUT-NEXT: } *)
(* CHECK-STDOUT-NEXT: fn f1 adder(v0:env, v1:n) { *)
(* CHECK-STDOUT-NEXT:   b0(): *)
(* CHECK-STDOUT-NEXT:     v2 = closure f2(v1) *)
(* CHECK-STDOUT-NEXT:     return v2 *)
(* CHECK-STDOUT-NEXT:   b1(): *)
(* CHECK-STDOUT-NEXT:     fail Match at closure.sml:2.28 *)
(* CHECK-STDOUT-NEXT: } *)
(* CHECK-STDOUT-NEXT: fn f0 main() { *)
(* CHECK-STDOUT-NEXT:   b0(): *)
(* CHECK-STDOUT-NEXT:     v0:adder = closure f1() *)
(* CHECK-STDOUT-NEXT:     g0 := v0 *)
(* CHECK-STDOUT-NEXT:     v1:adder = g0 *)
(* CHECK-STDOUT-NEXT:     v2 = call f1[v1](#2) *)
(* CHECK-STDOUT-NEXT:     g1 := v2 *)
(* CHECK-STDOUT-NEXT:     v3:addTwo = g1 *)
(* CHECK-STDOUT-NEXT:     v4 = call v3(#1) *)
(* CHECK-STDOUT-NEXT:     g2 := v4 *)
(* CHECK-STDOUT-NEXT:     return #0 *)
(* CHECK-STDOUT-NEXT: } *)
