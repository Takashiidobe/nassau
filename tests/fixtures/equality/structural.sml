(* = compares values of equality types by structure. *)
datatype 'a tree = Leaf | Node of 'a tree * 'a * 'a tree
datatype color = Red | Green | Blue
datatype shape = Circle of int | Rect of int * int | Dot
fun check (name, result) = print (name ^ ": " ^ (if result then "true" else "false") ^ "\n")
val () = check ("trees", Node (Leaf, 1, Node (Leaf, 2, Leaf)) = Node (Leaf, 1, Node (Leaf, 2, Leaf)))
val () = check ("different trees", Node (Leaf, 1, Leaf) = Node (Leaf, 2, Leaf))
val () = check ("leaf and node", Leaf = Node (Leaf, "x", Leaf))
val () = check ("colors", Red = Red andalso Red <> Blue)
val () = check ("shapes", Rect (1, 2) = Rect (1, 2) andalso Circle 1 <> Rect (1, 1) andalso Dot <> Circle 0)
val () = check ("options", SOME [1, 2] = SOME [1, 2] andalso SOME [1] <> NONE)
val () = check ("records", {a = 1, b = "x"} = {b = "x", a = 1})
val () = check ("nested", [(1, "a", [SOME Red])] = [(1, "a", [SOME Red])])
val () = check ("strings", "abc" <> "abcd")
val () = check ("chars", #"a" = #"a")
val () = check ("units", () = ())
val () = check ("orders", LESS <> GREATER)
val () = check ("words", 0w7 = 0wx7)
(* References are equal only to themselves. *)
val r = ref 1
val s = ref 1
val () = check ("same ref", r = r)
val () = check ("equal contents", r = s)
val () = check ("ref in data", SOME r = SOME r andalso [r] <> [s])
(* A long list compares in constant stack. *)
fun upto (n, acc) = if n = 0 then acc else upto (n - 1, n :: acc)
val () = check ("long lists", upto (200000, []) = upto (200000, []))
