fun show xs = foldl (fn (n, acc) => acc ^ Int.toString n ^ ";") "" xs ^ "\n"
fun opt NONE = "none\n" | opt (SOME n) = Int.toString n ^ "\n"
fun tried f = (f (); "ok\n") handle List.Empty => "Empty\n" | Subscript => "Subscript\n" | Size => "Size\n"
val xs = [1, 2, 3, 4, 5]
val () = print (show (List.rev xs) ^ show (rev xs) ^ show (xs @ [6]) ^ show (List.@ (xs, [7])) ^ show (foldl List.@ [] [[1], [2, 3]]) ^ show (List.concat [[1], [], [2, 3]]))
val () = print (show (List.revAppend ([3, 2, 1], [4])) ^ show (List.take (xs, 2)) ^ show (List.drop (xs, 2)))
val () = print (Int.toString (hd xs) ^ Int.toString (List.hd xs) ^ show (tl xs) ^ show (List.tl [1]))
val () = print (Int.toString (List.length xs) ^ Int.toString (List.last xs) ^ Int.toString (List.nth (xs, 2)) ^ "\n")
val () = print (opt (List.find (fn n => n > 3) xs) ^ opt (List.find (fn n => n > 9) xs))
val () = print (case List.getItem xs of SOME (h, t) => Int.toString h ^ show t | NONE => "none\n")
val () = print ((if List.null [] then "null " else "") ^ (if null xs then "" else "nonnull") ^ "\n")
val () = List.app (fn n => print (Int.toString n)) xs
val () = app (fn n => print (Int.toString n)) xs
val () = print "\n"
val () = print (show (List.mapPartial (fn n => if n mod 2 = 0 then SOME (n * 10) else NONE) xs))
val (small, large) = List.partition (fn n => n < 3) xs
val () = print (show small ^ show large)
val () = print (Int.toString (List.foldl (fn (x, acc) => acc * 10 + x) 0 xs) ^ " " ^ Int.toString (List.foldr (fn (x, acc) => acc * 10 + x) 0 xs) ^ " " ^ Int.toString (foldr (fn (x, acc) => acc - x) 0 xs) ^ "\n")
val () = print (show (List.map (fn n => n * n) xs) ^ show (List.tabulate (4, fn i => i * 2)) ^ show (List.tabulate (0, fn i => i)))
val calls = ref ""
val _ = List.tabulate (3, fn i => (calls := !calls ^ Int.toString i; i))
val () = print (!calls ^ "\n")
val () = print ((if List.exists (fn n => n > 4) xs then "e" else "-") ^ (if List.exists (fn n => n > 5) xs then "e" else "-") ^ (if List.all (fn n => n > 0) xs then "a" else "-") ^ (if List.all (fn n => n > 1) xs then "a" else "-") ^ "\n")
fun cmp (a : int, b) = if a < b then LESS else if a = b then EQUAL else GREATER
val () = print (case List.collate cmp ([1, 2], [1, 3]) of LESS => "less" | EQUAL => "equal" | GREATER => "greater")
val () = print (case List.collate cmp ([1, 2], [1, 2]) of LESS => "less" | EQUAL => "equal" | GREATER => "greater")
val () = print (case List.collate cmp ([1, 2, 0], [1, 2]) of LESS => "less" | EQUAL => "equal" | GREATER => "greater")
val () = print "\n"
val () = print (tried (fn () => hd []) ^ tried (fn () => List.tl []) ^ tried (fn () => List.last []))
val () = print (tried (fn () => List.nth (xs, 5)) ^ tried (fn () => List.nth (xs, ~1)) ^ tried (fn () => List.take (xs, 6)) ^ tried (fn () => List.take (xs, ~1)))
val () = print (tried (fn () => List.drop (xs, 6)) ^ tried (fn () => List.drop (xs, 5)) ^ tried (fn () => List.tabulate (~1, fn i => i)))
fun upto n = List.tabulate (n, fn i => i)
val () = print (Int.toString (List.length (upto 20000 @ upto 20000)) ^ " " ^ Int.toString (List.foldl (fn (a, b) => a + b) 0 (List.map (fn n => n) (upto 20000))) ^ " " ^ Int.toString (List.last (List.rev (upto 20000))) ^ "\n")
