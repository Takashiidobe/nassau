fun bytes s = Word8VectorSlice.full (Byte.stringToBytes s)
fun text v = Byte.bytesToString v

val listener = INetSock.TCP.socket ()
val () = Socket.bind (listener, INetSock.any 0)
val () = Socket.listen (listener, 5)
val (_, port) = INetSock.fromAddr (Socket.Ctl.getSockName listener)
val client = INetSock.TCP.socket ()
val loopback = valOf (NetHostDB.fromString "127.0.0.1")
val () = Socket.connect (client, INetSock.toAddr (loopback, port))
val (server, peer) = Socket.accept listener
val () = print (Bool.toString (port > 0) ^ "\n")
val () = print (NetHostDB.toString (#1 (INetSock.fromAddr peer)) ^ "\n")
val sent = Socket.sendVec (client, bytes "hello")
val () = print (Int.toString sent ^ " " ^ text (Socket.recvVec (server, 5)) ^ "\n")
val _ = Socket.sendVec (server, bytes "world")
val () = print (text (Socket.recvVec (client, 5)) ^ "\n")
val () = Socket.shutdown (client, Socket.NO_SENDS)
val () = print (Int.toString (Word8Vector.length (Socket.recvVec (server, 5))) ^ "\n")
val () = (Socket.close server; Socket.close client; Socket.close listener)

val (left, right) = UnixSock.Strm.socketPair ()
val _ = Socket.sendVec (left, bytes "ping")
val () = print (text (Socket.recvVec (right, 4)) ^ "\n")
val () = (Socket.close left; Socket.close right)

val refused = INetSock.TCP.socket ()
val () = print ((Socket.connect (refused, INetSock.toAddr (loopback, port)); "connected\n")
                handle OS.SysErr _ => "refused\n")
(* CHECK-STDOUT: true *)
(* CHECK-STDOUT-NEXT: 127.0.0.1 *)
(* CHECK-STDOUT-NEXT: 5 hello *)
(* CHECK-STDOUT-NEXT: world *)
(* CHECK-STDOUT-NEXT: 0 *)
(* CHECK-STDOUT-NEXT: ping *)
(* CHECK-STDOUT-NEXT: refused *)
(* CHECK-EXIT: 0 *)
