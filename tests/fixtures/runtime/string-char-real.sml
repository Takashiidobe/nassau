fun pi n = print (Int.toString n ^ "\n")
val () = pi (ord #"A" + ord (chr 66))
val () = print (str #"x" ^ implode [#"a", #"b"] ^ concat ["c", "d", "e"] ^ "\n")
val () = pi (length (explode "hello"))
val () = print (implode (rev (explode "abc")) ^ "\n")
val () = pi (floor (real 7 / 2.0))
val () = pi (floor (~0.5))
val () = print (String.concatWith ", " ["a", "b", "c"] ^ "\n")
val () = pi (ord (String.sub ("xyz", 1)))
val () = pi ((floor 1e30) handle Overflow => ~1)
val () = pi ((ord (chr 300)) handle Chr => ~2)
val () = pi ((ord (String.sub ("xyz", 3))) handle Subscript => ~3)
fun repeat (s, n) = if n = 0 then [] else s :: repeat (s, n - 1)
val big = concat (repeat ("abcde", 4000))
val () = pi (size big)
val () = pi (length (explode big))
val () = pi (size (implode (explode big)))
val () = print (String.str (String.sub (big, 19999)) ^ "\n")
val () = pi (size (concat []) + size (concat ["x"]))
val () = pi (length (explode ""))
