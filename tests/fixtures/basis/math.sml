fun show x = print (Int.toString (Real.floor (x * 1000.0)) ^ "\n")
val _ = show (Math.sqrt 2.0)
val _ = show (Math.sin 1.0)
val _ = show (Math.cos 1.0)
val _ = show (Math.tan 1.0)
val _ = show (Math.asin 0.5)
val _ = show (Math.acos 0.5)
val _ = show (Math.atan 1.0)
val _ = show (Math.atan2 (1.0, 2.0))
val _ = show (Math.exp 1.0)
val _ = show (Math.pow (2.0, 10.0))
val _ = show (Math.ln 10.0)
val _ = show (Math.log10 1000.0)
val _ = show (Math.sinh 1.0)
val _ = show (Math.cosh 1.0)
val _ = show (Math.tanh 1.0)
val _ = show Math.pi
val _ = show Math.e
open Math
