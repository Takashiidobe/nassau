(* POLYML-SKIP: libm crate differs from glibc by 1 ulp for cosh 10 and pow (10, 2.5) *)
fun pad d = if d < 10 then "00" ^ Int.toString d else if d < 100 then "0" ^ Int.toString d else Int.toString d

fun fraction (f, 0) = ""
  | fraction (f, n) =
      let val y = f * 1000.0
          val d = Real.floor y
      in pad d ^ fraction (y - Real.fromInt d, n - 1) end

fun digits x =
  if x < 0.0 then "-" ^ digits (~x)
  else let val whole = Real.floor x
       in Int.toString whole ^ "." ^ fraction (x - Real.fromInt whole, 5) end

fun row name (arg, value) = print (name ^ " " ^ digits arg ^ " = " ^ digits value ^ "\n")

fun unary name f = List.app (fn x => row name (x, f x)) [0.1, 0.5, 0.9, 1.5, 2.5, 10.0]
fun unit name f = List.app (fn x => row name (x, f x)) [0.05, 0.3, 0.5, 0.75, 0.99]

val _ = unary "sin" Math.sin
val _ = unary "cos" Math.cos
val _ = unary "tan" Math.tan
val _ = unit "asin" Math.asin
val _ = unit "acos" Math.acos
val _ = unary "atan" Math.atan
val _ = unary "exp" Math.exp
val _ = unary "ln" Math.ln
val _ = unary "log10" Math.log10
val _ = unary "sinh" Math.sinh
val _ = unary "cosh" Math.cosh
val _ = unary "tanh" Math.tanh
